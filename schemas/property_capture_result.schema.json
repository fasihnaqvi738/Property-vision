{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "property_capture_result.schema.json",
  "title": "Property Vision capture result",
  "description": "Shared per-capture output contract for photo, video, and LiDAR/RGB-D inputs. Unsupported results must be represented with explicit statuses and limitations, not fabricated measurements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_status",
    "capture",
    "reconstruction",
    "property_plan",
    "damage_regions",
    "concealed_damage_flags",
    "scope_line_items",
    "quality",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_status": { "enum": ["complete", "partial", "failed"] },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture_id", "tier", "source_format", "device", "input_files"],
      "properties": {
        "capture_id": { "type": "string", "minLength": 1 },
        "tier": { "enum": ["photo", "video", "lidar"] },
        "source_format": { "type": "string", "minLength": 1 },
        "device": { "type": ["string", "null"] },
        "input_files": { "type": "array", "items": { "type": "string" } }
      }
    },
    "reconstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "summary"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "method": { "type": "string" },
        "summary": { "type": "object" }
      }
    },
    "property_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "coordinate_system", "rooms", "stitched_plan"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "coordinate_system": { "type": "string" },
        "rooms": { "type": "array", "items": { "$ref": "#/$defs/room" } },
        "stitched_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "adjacency", "footprint", "overlaps"],
          "properties": {
            "status": { "$ref": "#/$defs/status" },
            "adjacency": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["room_a", "room_b", "connector"],
                "properties": {
                  "room_a": { "type": "string" },
                  "room_b": { "type": "string" },
                  "connector": { "type": ["string", "null"] }
                }
              }
            },
            "footprint": { "$ref": "#/$defs/measurement" },
            "overlaps": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    },
    "damage_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["region_id", "surface_id", "class", "extent", "confidence"],
        "properties": {
          "region_id": { "type": "string" },
          "surface_id": { "type": "string" },
          "class": { "type": "string" },
          "extent": { "$ref": "#/$defs/measurement" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "concealed_damage_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["flag_id", "surface_id", "rule_id", "rationale", "evidence"],
        "properties": {
          "flag_id": { "type": "string" },
          "surface_id": { "type": "string" },
          "rule_id": { "type": "string" },
          "rationale": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "scope_line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "surface_id", "description", "quantity"],
        "properties": {
          "item_id": { "type": "string" },
          "surface_id": { "type": "string" },
          "description": { "type": "string" },
          "quantity": { "$ref": "#/$defs/measurement" }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drift_handling", "calibration_by_tier"],
      "properties": {
        "drift_handling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "method", "ablation_artifact"],
          "properties": {
            "status": { "$ref": "#/$defs/status" },
            "method": { "type": "string" },
            "ablation_artifact": { "type": ["string", "null"] }
          }
        },
        "calibration_by_tier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["photo", "video", "lidar"],
          "properties": {
            "photo": { "$ref": "#/$defs/calibration" },
            "video": { "$ref": "#/$defs/calibration" },
            "lidar": { "$ref": "#/$defs/calibration" }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendered_plan", "point_cloud", "raw_capture"],
      "properties": {
        "rendered_plan": { "type": ["string", "null"] },
        "point_cloud": { "type": ["string", "null"] },
        "raw_capture": { "type": "array", "items": { "type": "string" } },
        "debug_views": { "type": "array", "items": { "type": "string" } }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "status": { "enum": ["complete", "partial", "unavailable", "failed"] },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "unit", "interval", "method"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "value": { "type": ["number", "null"] },
        "unit": { "type": "string" },
        "interval": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["lower", "upper", "confidence_level"],
          "properties": {
            "lower": { "type": "number" },
            "upper": { "type": "number" },
            "confidence_level": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        },
        "method": { "type": "string" }
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["room_id", "status", "footprint", "walls", "ceiling_height", "floor_area", "openings", "surfaces"],
      "properties": {
        "room_id": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "footprint": { "type": "array", "items": { "$ref": "#/$defs/point2" } },
        "walls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["surface_id", "length", "surface_area"],
            "properties": {
              "surface_id": { "type": "string" },
              "length": { "$ref": "#/$defs/measurement" },
              "surface_area": { "$ref": "#/$defs/measurement" }
            }
          }
        },
        "ceiling_height": { "$ref": "#/$defs/measurement" },
        "floor_area": { "$ref": "#/$defs/measurement" },
        "openings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["opening_id", "type", "width", "surface_id"],
            "properties": {
              "opening_id": { "type": "string" },
              "type": { "enum": ["door", "window", "other", "unknown"] },
              "width": { "$ref": "#/$defs/measurement" },
              "surface_id": { "type": ["string", "null"] }
            }
          }
        },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["surface_id", "type", "area"],
            "properties": {
              "surface_id": { "type": "string" },
              "type": { "enum": ["wall", "floor", "ceiling", "opening", "other"] },
              "area": { "$ref": "#/$defs/measurement" }
            }
          }
        }
      }
    },
    "point2": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sample_count", "interval_coverage", "median_error"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "sample_count": { "type": "integer", "minimum": 0 },
        "interval_coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "median_error": { "$ref": "#/$defs/measurement" }
      }
    }
  }
}
